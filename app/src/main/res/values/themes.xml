<?xml version="1.0" encoding="utf-8"?>
<!-- ARCHIVO: themes.xml - Tema XML base de la actividad (sin ActionBar). La apariencia real la da Compose. -->
<resources>

    <!-- Tema del sistema aplicado antes de que Compose dibuje MyApplicationTheme. -->
    <!-- Fondo oscuro desde el arranque para evitar el flash claro antes de Compose. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#101229</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
